# Copy as .env on the target server; supply secrets separately.
HOST=127.0.0.1
PORT=8080
APP_ORIGIN=http://127.0.0.1:8080
NODE_ENV=development
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEMO_PASSWORD=
SESSION_SECRET=

# Keep paid endpoints behind team login unless a public demo is intended.
PUBLIC_DEMO_MODE=0
